# Login/signup and Audio Studio now talk to real infrastructure (Postgres +
# the autocanvas-api backend process) instead of in-memory dummy data.
# Billing checkout (app/(app)/billing/actions.ts) is still simulated with
# lib/dummy-data.ts and hasn't been reconnected yet — that's why the
# Stripe/Razorpay vars below are still unused.

# Required: NextAuth signs/verifies session JWTs with this. Any long random
# string works for local dev, e.g. `openssl rand -base64 32`. This SAME
# value must also be set as AUTH_SECRET in the autocanvas-api backend's own
# .env — it's the shared secret the bridge-token pattern (see
# packages/auth/src/bridge-token.ts) uses to sign a short-lived token here
# and verify it there. If the two don't match, every Audio Studio request
# fails auth with a clear "invalid bridge token" error.
AUTH_SECRET=""

# Required: this app's own Postgres connection — used directly by
# packages/auth/src/config.ts (real Credentials login), the register/
# forgot-password/reset-password routes, and @platform/credits (signup
# bonus grant). Must point at the SAME database the autocanvas-api backend
# migrates/seeds (packages/database/prisma/schema.prisma is identical in
# both projects) — this app and the backend are two processes sharing one
# database, not two separate databases.
DATABASE_URL="postgresql://user:password@localhost:5432/autocanvas"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required for Audio Studio: base URL of the running autocanvas-api
# backend process (see app/(app)/audio/actions.ts -> lib/backend-client.ts).
BACKEND_URL="http://localhost:4000"

# Optional: forgot-password emails. If RESEND_API_KEY is left blank,
# lib/email.ts falls back to logging the reset link to the server console
# instead of sending a real email — handy for local dev/testing, but set a
# real key before going live so users actually receive the email.
RESEND_API_KEY=""
EMAIL_FROM="AutoCanvas <no-reply@autocanvas.local>"

# Not wired up yet — this phase of login/signup is email+password only
# (see packages/auth/src/config.ts). Left here for whenever Google sign-in
# is scoped as a follow-up.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# app/(app)/billing/actions.ts still calls the dummy in-memory store, not
# @platform/billing — checkout is simulated. These are only read by the
# Stripe/Razorpay webhook routes (app/api/webhooks/*), which nothing
# currently sends real deliveries to.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
