# Next.js only reads .env.local from within apps/web itself (not the repo
# root). For local dev, copy the matching values from the root .env here —
# at minimum: DATABASE_URL, AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET,
# NEXT_PUBLIC_APP_URL. See root .env.example for the full list and comments.

DATABASE_URL=""
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Added Chunk 9 (packages/billing) — needed by both webhook routes
# (app/api/webhooks/stripe, app/api/webhooks/razorpay) and the checkout
# Server Action (app/billing/actions.ts), all of which run inside this app.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Added Chunk 10 (apps/backend) — where Audio Studio's Server Actions
# (app/(app)/audio/actions.ts) send their HTTP calls. Run apps/backend
# locally (pnpm --filter @platform/backend dev) and point this at it.
BACKEND_URL="http://localhost:4000"
