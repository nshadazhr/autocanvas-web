# DUMMY MODE build — this app runs entirely on in-memory mock data (see
# lib/dummy-data.ts) so it needs neither a Postgres database nor a running
# backend process. The only variable that actually matters below is
# AUTH_SECRET; everything else is left in place, unused, for whenever this
# is pointed back at real infrastructure.

# Required: NextAuth signs/verifies session JWTs with this. Any long random
# string works for local dev, e.g. `openssl rand -base64 32`.
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Everything below is NOT needed to run this dummy-mode build ───────────
# packages/auth/src/config.ts no longer uses PrismaAdapter or a DB-backed
# Credentials check, so DATABASE_URL isn't read. Google sign-in is removed
# in dummy mode (see config.ts), so AUTH_GOOGLE_* isn't read either.
DATABASE_URL=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# app/(app)/billing/actions.ts no longer calls @platform/billing — checkout
# is simulated instantly in lib/dummy-data.ts. These are only read by the
# Stripe/Razorpay webhook routes (app/api/webhooks/*), which dummy mode
# never receives real deliveries for.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# app/(app)/audio/actions.ts no longer calls out to apps/backend — Audio
# Studio is backed by the same in-memory store as everything else.
BACKEND_URL="http://localhost:4000"
